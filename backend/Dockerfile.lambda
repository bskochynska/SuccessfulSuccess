FROM public.ecr.aws/lambda/python:3.12

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/var/task"

WORKDIR /var/task

# 1. Встановлюємо uv безпосередньо через pip
RUN pip install --no-cache-dir uv

# 2. Встановлюємо залежності проєкту
COPY pyproject.toml ./
RUN uv pip install --no-cache --compile-bytecode --target "/var/task" -r pyproject.toml

# 3. Копіюємо виправлену папку app
COPY app /var/task/app

# 4. Створюємо пакетні файли
RUN touch /var/task/__init__.py && \
    touch /var/task/app/__init__.py && \
    touch /var/task/app/ai/__init__.py && \
    touch /var/task/app/api/__init__.py

CMD ["app.ai.agenda_lambda.handler"]
